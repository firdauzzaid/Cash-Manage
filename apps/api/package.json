{
  "name": "@cashflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "test": "tsx --env-file=../../.env --test test/*.test.ts"
  },
  "dependencies": {
    "@cashflow/contracts": "0.1.0",
    "fastify": "5.12.7",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "pg": "8.23.1",
    "better-auth": "1.7.11",
    "@better-auth/expo": "1.7.11",
    "nodemailer": "10.1.7",
    "node-pg-migrate": "9.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/nodemailer": "^7.0.0"
  }
}
